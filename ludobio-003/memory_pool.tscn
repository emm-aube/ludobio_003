[node name="RichTextLabel" parent="CTN_Mum/M_LotsOfStuff" index="1" unique_id=676347016]
text = "Mum would do all sort of things to  help me quiet    down when the   migraines were     too hard.    
 She was sad to  see me like this."
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

[node name="M_Stick" parent="CTN_Mum" unique_id=1632631390 instance=ExtResource("4_xe1s3")]
position = Vector2(-500, 500)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Mum/M_Stick" index="1" unique_id=676347016]
text = " There was this  weird mint stick for my forehead  she brought back home once. I used to pretend it    worked just to   make her happy. "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

[node name="M_Silence" parent="CTN_Mum" unique_id=1551475065 instance=ExtResource("4_xe1s3")]
position = Vector2(-700, 100)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Mum/M_Silence" index="1" unique_id=676347016]
text = " She was careful to not make any   loud sound. It   was making my    head explode.   Even crackings of  the flooring       parquet.     "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

[node name="M_Towel" parent="CTN_Mum" unique_id=1147659476 instance=ExtResource("4_xe1s3")]
position = Vector2(-900, 300)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Mum/M_Towel" index="1" unique_id=676347016]
text = " She put a cold     towel on my     forehead. She  would come often  to make sure it  was still cold, and changed it if     needed.     "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true


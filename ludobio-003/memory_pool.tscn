[node name="RichTextLabel" parent="CTN_Allergies/Allergies_Run" index="1" unique_id=676347016]
text = "There was a time, while running, I  got a reaction to pollen so bad my throat swelled  to the point I could barely call    for help.    "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

[node name="Allergies_Samu" parent="CTN_Allergies" unique_id=391361629 instance=ExtResource("4_xe1s3")]
position = Vector2(1300, 1300)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Allergies/Allergies_Samu" index="1" unique_id=676347016]
text = "  The emergency   doctor arrived    gave me a pill  and waited with me for some time.   But It passed   rapidly and he       left.       "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true


[node name="RichTextLabel" parent="CTN_Benjamin/M_Pharmacy" index="1" unique_id=676347016]
text = "His parents had a wineyard where I worked during   summers. One day, selling wine at a market, I had a migraine so bad I threw up there."
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

[node name="M_Cerbere" parent="CTN_Benjamin" unique_id=1969155995 instance=ExtResource("4_xe1s3")]
position = Vector2(300, 1900)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Benjamin/M_Cerbere" index="1" unique_id=676347016]
text = "They often took  me to their fancy vacation house.   Once, I had a    migraine in thecar but,  afraid to ruin the day,  I said nothing. "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true


[node name="RichTextLabel" parent="CTN_Mamie/M_Mamie" index="1" unique_id=676347016]
text = "Grandma. She used to say that she was the one that
   passed on the
migraines to my
 aunts and me.  
Hers were really strong as well.   "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

[node name="M_FakePills" parent="CTN_Mamie" unique_id=1124303571 instance=ExtResource("4_xe1s3")]
position = Vector2(1100, 300)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Mamie/M_FakePills" index="1" unique_id=676347016]
text = "She was so scared   of having a   migraine  that,   at some point,  she took drugs   everyday. Dad wassecretly emptying  the capsules.  "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

[node name="M_StayAtHers" parent="CTN_Mamie" unique_id=288528141 instance=ExtResource("4_xe1s3")]
position = Vector2(900, -100)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Mamie/M_StayAtHers" index="1" unique_id=676347016]
text = "When a migraine  kicked in before school started,  I was left with  Grandma. If I got better by noon, I could enjoy a  free afternoon.  "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true


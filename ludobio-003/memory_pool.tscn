[node name="Mum" parent="." unique_id=619825665 node_paths=PackedStringArray("association_array") instance=ExtResource("4_xe1s3")]
position = Vector2(100, 900)
recollection_target = 300.0
association_array = [NodePath("../end_test"), NodePath("../txt_pill"), NodePath("../txt_migraine")]

[node name="RichTextLabel" parent="Mum" index="1" unique_id=676347016]
text = "                      ///////        //////////       // <  < ///   /|  /    D        |  -   /          ----                            "

[node name="txt_pill" parent="." unique_id=796501890 instance=ExtResource("4_xe1s3")]
position = Vector2(1700, 900)
recollection_target = 300.0

[node name="TextureRect" parent="txt_pill" index="0" unique_id=586980597 groups=["empty"]]

[node name="RichTextLabel" parent="txt_pill" index="1" unique_id=676347016 groups=["empty"]]
text = "So many pills in my body and brain. Migraine pills. Sleep pills. Allergy pills. But migraine pills were the first ones. Since childhood."
metadata/_edit_use_anchors_ = true

[node name="end_test" parent="." unique_id=1850093116 instance=ExtResource("4_xe1s3")]
position = Vector2(500, 900)
recollection_target = 300.0

[node name="RichTextLabel" parent="end_test" index="1" unique_id=676347016]
text = "Is this really the endIs this really the endIs this really the endIs this really the endIs this really the endIs this really the endIs t"
metadata/_edit_use_anchors_ = true

[node name="txt_migraine" parent="." unique_id=986528102 groups=["empty"] instance=ExtResource("4_xe1s3")]
position = Vector2(300, 100)
recollection_target = 300.0

[node name="RichTextLabel" parent="txt_migraine" index="1" unique_id=676347016]
text = "It starts with a pressure, on one side of my forehead. I feel it taking over my body. And then I have to find a pill. It’s the solution."

[node name="Adam" parent="." unique_id=697131575 node_paths=PackedStringArray("association_array") instance=ExtResource("4_xe1s3")]
position = Vector2(300, 300)
recollection_target = 100.0
association_array = [NodePath("../txt_cycle"), NodePath("../txt_hallucination")]

[node name="TextureRect" parent="Adam" index="0" unique_id=586980597 groups=["empty"]]

[node name="RichTextLabel" parent="Adam" index="1" unique_id=676347016 groups=["empty"]]
text = "                        @ @@@@@  
  @@,  , @@   
   |<  <  @@  
   | |    D   
   |  >  /    
   \\___/     
                                  "
metadata/_edit_use_anchors_ = true

[node name="txt_cycle" parent="." unique_id=825007607 instance=ExtResource("4_xe1s3")]
position = Vector2(1900, 300)
recollection_target = 300.0

[node name="RichTextLabel" parent="txt_cycle" index="1" unique_id=676347016]
text = "The migraine wouldn’t stop. I had been in the bed for the entire day and was getting crazy. So he biked to Charly’s to get some for me. "
metadata/_edit_use_anchors_ = true

[node name="txt_hallucination" parent="." unique_id=754135681 groups=["empty", "end"] instance=ExtResource("4_xe1s3")]
position = Vector2(700, 100)
recollection_target = 300.0

[node name="RichTextLabel" parent="txt_hallucination" index="1" unique_id=676347016]
text = "This time I had taken too many pills and hallucinated for a few hours. Lost myself in the city. Eventually, I had to go to the hospital."

[node name="Mamy" parent="." unique_id=1628032868 node_paths=PackedStringArray("association_array") instance=ExtResource("4_xe1s3")]
position = Vector2(1300, 500)
recollection_target = 700.0
association_array = [NodePath("../txt_pharrmacy"), NodePath("../txt_psychic")]

[node name="TextureRect" parent="Mamy" index="0" unique_id=586980597 groups=["empty"]]

[node name="RichTextLabel" parent="Mamy" index="1" unique_id=676347016 groups=["empty"]]
text = "                     ********        ***********      *_/ \\_/ \\_*      C| \\'/c\\'/ |D     |   ___   |       \\_______/                    "
metadata/_edit_use_anchors_ = true

[node name="txt_pharrmacy" parent="." unique_id=1488993170 groups=["empty"] instance=ExtResource("4_xe1s3")]
position = Vector2(500, 100)
recollection_target = 300.0

[node name="RichTextLabel" parent="txt_pharrmacy" index="1" unique_id=676347016]
text = "Was away for a weekend and forgot my pills. I almost fainted in the pharmacy. Begged the pharmacist to give me one without prescription."

[node name="txt_psychic" parent="." unique_id=1212633976 groups=["empty"] instance=ExtResource("4_xe1s3")]
position = Vector2(900, 100)
recollection_target = 300.0

[node name="RichTextLabel" parent="txt_psychic" index="1" unique_id=676347016]
text = "My aunt took me to a psychic. Gave me a “magic” marble to roll on my forehead when migraines start. Bullcrap.                           "


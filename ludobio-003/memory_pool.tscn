[node name="Allergies_ZyrtecBis" parent="CTN_Allergies" unique_id=1053673068 instance=ExtResource("4_xe1s3")]
position = Vector2(1700, 1100)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Allergies/Allergies_ZyrtecBis" index="1" unique_id=676347016]
text = " I carried these 
pills with me all
 the time in case of allergic 
   reaction.    
   Luckily, I   
 haven't had to 
use any in years. "
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

[node name="Allergies_OK" parent="CTN_Allergies" unique_id=823883188 instance=ExtResource("4_xe1s3")]
position = Vector2(1700, 700)
recollection_target = 200.0

[node name="RichTextLabel" parent="CTN_Allergies/Allergies_OK" index="1" unique_id=676347016]
text = "I had asthmatic 
bronchitis as a 
kid. But really I
only remember my parents talking 
about it. But I 
recall allergic 
reactions later."
autowrap_trim_flags = 0
justification_flags = 0
metadata/_edit_use_anchors_ = true

